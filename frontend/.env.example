# ── FastAPI / LangGraph (default) ─────────────────────────────
# Local dev: leave unset — requests go to /api (Vite proxies to port 8000)
# Production:
# VITE_PYTHON_API_URL=https://api.yourdomain.com

# ── n8n workflow (env only — see docs/N8N_CONNECTION.md) ───────
# VITE_USE_N8N=true
# VITE_N8N_WEBHOOK_URL=https://your-n8n-host/webhook/your-path
